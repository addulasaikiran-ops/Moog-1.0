generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Share {
  id           String    @id @default(cuid())
  text         String
  language     String    @default("text")
  tokenHash    String    @unique
  imageData    Bytes?
  imageMime    String?
  imageName    String?
  passwordHash String?
  viewOnce     Boolean   @default(false)
  viewedAt     DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@index([viewOnce, viewedAt])
}