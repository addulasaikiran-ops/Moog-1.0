generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
model Share {
  id              String    @id @default(cuid())
  ownerUid        String?
  text            String
  language        String    @default("text")
  tokenHash       String    @unique
  codeHash        String?   @unique
  revokeTokenHash String?   @unique
  imageData       Bytes?
  imageMime       String?
  imageName       String?
  passwordHash    String?
  viewOnce        Boolean   @default(false)
  viewedAt        DateTime?
  revealTokenHash String?   @unique
  rConsumedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  @@index([expiresAt])
  @@index([viewOnce, viewedAt])
  @@index([revokedAt])
  @@index([ownerUid])
}