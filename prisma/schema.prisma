generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
model Share {
  id              String    @id @default(cuid())
  text            String
  language        String    @default("text")
  tokenHash       String    @unique
  codeHash        String?   @unique
  imageData       Bytes?
  imageMime       String?
  imageName       String?
  passwordHash    String?
  viewOnce        Boolean   @default(false)
  viewedAt        DateTime?
  revealTokenHash String?   @unique
  rConsumedAt     DateTime?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  @@index([expiresAt])
  @@index([viewOnce, viewedAt])
}

model AbuseReport {
  id         String   @id @default(cuid())
  shareUrl   String
  category   String
  email      String?
  details    String
  createdAt  DateTime @default(now())
  status     String   @default("open")
  @@index([createdAt])
  @@index([status, createdAt])
}
